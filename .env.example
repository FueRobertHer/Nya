# Copy to .env.local for local development, or run `vercel env pull .env.local`
# after connecting the Vercel project and its Upstash database. Every variable is
# described in docs/deployment.md.
#
# Generate any secret or key below with:  openssl rand -base64 32

# --- Plaid (https://dashboard.plaid.com/team/keys) ---
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox

# --- Upstash Redis ---
# Added for you by the Upstash for Redis integration in the Vercel Marketplace.
# Stores migrated from Vercel KV use KV_REST_API_URL / KV_REST_API_TOKEN instead;
# both are supported. The URL must be the HTTPS REST endpoint
# (https://<name>.upstash.io). A rediss://...:6379 connection string is tolerated
# (the REST URL is derived from its host), but an https:// value is preferred.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Encryption ---
# Encrypts Plaid access tokens and everything written before data keys existed.
# Never remove it while any value still uses it.
PLAID_ENCRYPTION_KEY=

# Master key (lib/crypto.ts): encrypts the data keys the app keeps in Redis, never
# your data directly. Save it in your password manager FIRST, since without it
# nothing under a data key can be read, from the database or from a backup. Once
# set, new data is written under a data key; unset, everything stays under
# PLAID_ENCRYPTION_KEY. To rotate it, see docs/operations.md.
MASTER_KEY=

# --- Sign-in ---
# The shared password that gates the app, and the secret that signs its session
# cookies. Used when Clerk (below) is not configured, and as the fallback.
APP_PASSWORD=
SESSION_SECRET=

# Optional: sign in with Clerk instead (docs/authentication.md). Both keys turn it
# on. Only people on the allowlist get in: comma-separated Clerk user ids
# (user_...) and/or email addresses. Empty lets nobody in.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_ALLOWED_USER_IDS=

# --- Content-Security-Policy (lib/security-headers.ts) ---
# How pages send their policy: report-only (the default) logs in the browser
# console what it would block and blocks nothing; enforce blocks it; off sends
# none. Leave it unset until a live Plaid Link and Clerk session shows no
# violations, then set enforce. The check is in docs/deployment.md. Any other
# value counts as report-only.
# CSP_MODE=report-only

# --- Scheduled jobs and scripted access ---
# Authenticates the crons in vercel.json (Vercel sends it as a Bearer token).
CRON_SECRET=

# Authenticates POST /api/ingest/balance, which lets a script push balances into
# manual accounts. Leave it UNSET to keep the endpoint closed (it 401s). Use a
# value different from CRON_SECRET so they can be rotated independently.
INGEST_SECRET=

# Backups and other operations (/api/ops/*). The routes answer 404 unless
# OPS_ENABLED=1, so leave that unset except while you are running an operation:
# a leaked OPS_SECRET is then useless on its own. Use a value different from every
# other secret here.
OPS_SECRET=
OPS_ENABLED=

# Nightly off-site backup (docs/operations.md). Set for you when a private Vercel
# Blob store is connected; the backup cron does nothing without it.
# BLOB_READ_WRITE_TOKEN=
# BACKUP_KEEP_DAYS=30

# --- Plaid cost and storage tuning ---
# Public https URL of /api/plaid/webhook on this deployment. With it set, Plaid
# tells the app when new data is ready and dashboard loads are served from stored
# data for hours instead of minutes. Unset, webhooks are off.
# PLAID_WEBHOOK_URL=https://your-app.vercel.app/api/plaid/webhook

# Days an Item may be unreadable, or have every account hidden, before the daily
# check flags it for the admin to review (default 60, minimum 14). It only flags:
# nothing is removed unless the admin disconnects it.
# PLAID_UNUSED_DAYS=60

# Ceiling, in characters, on one Item's stored transaction blob (default 8388608,
# a margin under the 10 MB request limit on Upstash's free plan). A blob over the
# ceiling is REFUSED, never trimmed, so the institution stops updating and says so.
# Raising this on a bigger plan resumes it with its history intact.
# MAX_TXN_BLOB_CHARS=

# --- Containers and namespaces ---
# Which container this deployment serves (docs/operations.md). Optional with Clerk,
# and with a single active container.
# CONTAINER_ID=

# Overrides the key namespace, which defaults to the Vercel environment name
# (production, preview) or "dev" locally. One plain segment: letters, digits, - and _.
# REDIS_PREFIX=

# Preview only: one-click demo accounts on the sign-in page, as
# "<clerk user id>:<label>, ...". Ignored outside Preview and local dev.
# DEMO_USER_IDS=

# --- Email notices about bank connections (lib/mail.ts, docs/deployment.md) ---
# One email when a connection breaks, and one reminder a week later. Sent
# through Resend's API; with either of these unset nothing is sent and the
# Connection health card on the Accounts tab is the only place a break shows.
# RESEND_API_KEY=
# MAIL_FROM=Nya <alerts@example.com>
# With the shared password, where the notices go (comma-separated for more
# than one). Ignored with Clerk: each account's go to its own verified address.
# NOTIFY_EMAIL=
# The app's public https address, for the link in each email.
# APP_URL=https://your-app.vercel.app
