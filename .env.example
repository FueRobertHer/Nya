# Plaid API credentials -- https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox

# Upstash Redis (Vercel KV's successor) -- auto-populated when you add the
# Upstash for Redis integration from the Vercel Marketplace (Storage tab ->
# Create Database -> Upstash for Redis -> Connect to Project).
# For local dev, run `vercel env pull .env.local` after connecting the
# database to pull these down automatically instead of typing them by hand.
# (Stores auto-migrated from old Vercel KV use the legacy names
# KV_REST_API_URL / KV_REST_API_TOKEN instead -- both are supported.)
#
# UPSTASH_REDIS_REST_URL must be the HTTPS *REST* endpoint
# (https://<name>.upstash.io), NOT a rediss://...:6379 connection string.
# `vercel env pull` sometimes writes the rediss:// value here; the app now
# tolerates that (it derives the REST URL from the host), but if you set this
# by hand, use the https:// one.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32-byte AES-256 key, base64-encoded, used to encrypt Plaid access tokens
# before they're written to KV. Generate with:
#   openssl rand -base64 32
PLAID_ENCRYPTION_KEY=

# The password required to open the app at all -- this is what protects your
# balances once the app is deployed to a public URL. Pick something real,
# not a placeholder.
APP_PASSWORD=

# Random secret used to sign session cookies so they can't be forged.
# Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Authenticates the daily snapshot cron (vercel.json -> /api/snapshot).
# Vercel automatically sends this as a Bearer token with cron requests when
# the env var is set on the project. Generate with:
#   openssl rand -base64 32
CRON_SECRET=

# Authenticates POSTs to /api/ingest/balance, which lets an outside script push
# balances into your manually-tracked accounts (a SimpleFIN puller, an OFX
# cron, a scraper on your own machine). Leave this UNSET to keep the endpoint
# closed -- it 401s everything until a secret exists. Use a different value
# from CRON_SECRET so the two can be rotated independently. Generate with:
#   openssl rand -base64 32
INGEST_SECRET=
